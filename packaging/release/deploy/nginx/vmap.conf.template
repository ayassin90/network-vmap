# Network VMap behind nginx (rendered at start by the nginx image; ${VMAP_HTTPS_PORT} comes from the compose file).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    location = /healthz { proxy_pass http://web:8000; }
    location / { return 301 https://$host:${VMAP_HTTPS_PORT}$request_uri; }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    ssl_certificate     /etc/nginx/certs/vmap.crt;
    ssl_certificate_key /etc/nginx/certs/vmap.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:vmap:10m;
    server_tokens off;
    client_max_body_size 50m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
