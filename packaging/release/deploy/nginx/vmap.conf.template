# Network VMap behind nginx (rendered at start by the nginx image; ${VMAP_HTTPS_PORT} comes from the compose file).
# "web" is looked up through Docker's DNS at request time (the variable in proxy_pass), not once at start: an upgrade or
# restart gives the web container a new address, and a cached one would leave nginx answering 502.
resolver 127.0.0.11 valid=10s ipv6=off;
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    location = /healthz { set $vmap_web http://web:8000; proxy_pass $vmap_web; }
    location / { return 301 https://$host:${VMAP_HTTPS_PORT}$request_uri; }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    ssl_certificate     /etc/nginx/certs/vmap.crt;
    ssl_certificate_key /etc/nginx/certs/vmap.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:vmap:10m;
    server_tokens off;
    client_max_body_size 50m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        set $vmap_web http://web:8000;
        proxy_pass $vmap_web;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
