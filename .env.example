# Copy to .env and change the secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
VMAP_ADMIN_USER=admin
VMAP_ADMIN_PASSWORD=change-me
VMAP_PORT=8090
# Comma-separated, needed when served over HTTPS behind a proxy, e.g. https://vmap.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Load the sample campus on first start (1 = yes)
VMAP_LOAD_DEMO=1
VMAP_WORKER_THREADS=16
TZ=UTC
# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vmap@example.com
# NetFlow / IPFIX listener published on the host (udp)
VMAP_FLOW_PORT=2055
# Set to 1 when users reach VMap over HTTPS (secure cookies, redirect http -> https)
VMAP_HTTPS=0
